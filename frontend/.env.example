# Frontend Environment Variables (.env)
# Copy this to frontend/.env and fill in your Firebase configuration

# Firebase Configuration - Get these from Firebase Console
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend API URL
VITE_API_BASE_URL=http://localhost:5000

# AI provider keys must stay in backend/.env only.
# Do not add VITE_GEMINI_API_KEY or VITE_GROQ_API_KEY here.

# Admin Secret (optional - for admin authentication)
VITE_ADMIN_SECRET=your_admin_secret_key
