# Backend Environment Variables (.env)
# Copy this to backend/.env and fill in your configuration

# Firebase Admin SDK - Get from Firebase Console > Project Settings > Service Accounts
# Option 1: Use service account JSON (paste as single line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option 2: Use project ID only (requires Google Application Default Credentials)
# FIREBASE_PROJECT_ID=your-project-id

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/neuroprepai
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/neuroprepai

# Admin Authentication
ADMIN_SECRET=your_secure_admin_secret_key

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Provider Routing
# Local default: USE_OLLAMA=true uses your local Ollama server.
# Production default: AI_PROVIDER=gemini uses Gemini, then falls back to Groq.
AI_PROVIDER=auto
# When true, local Ollama mode can fall back to Gemini/Groq if Ollama is down.
AI_FALLBACK_TO_CLOUD=false

# Gemini AI API (server-side only; never put this in frontend/.env)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
# Optional comma-separated fallback models if Google changes availability for your key.
GEMINI_MODEL_CANDIDATES=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.1-flash-lite,gemini-3.6-flash
# Optional endpoint override. A root/base URL is okay; the backend appends /models/<model>:generateContent.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Groq fallback API (server-side only; used when Gemini fails or rate-limits)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_MODEL_CANDIDATES=groq/compound-mini,qwen/qwen3.8-27b,qwen/qwen3.6-27b

# Ollama Configuration (local development)
USE_OLLAMA=true
OLLAMA_API_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Code Runner Configuration
# Free local development/demo runner. It uses runtimes installed on your machine.
# Supported language commands: node, python/python3, javac/java, gcc, g++.
# Keep this disabled in public production unless the server is properly sandboxed.
CODE_RUNNER_PROVIDER=local
LOCAL_CODE_RUNNER_ENABLED=true
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MAX_CODE_BYTES=65536

# Free self-hosted Judge0 option, for example with Docker Judge0 CE.
# If this is set to a non-RapidAPI URL, no API key is required.
# JUDGE0_URL=http://localhost:2358

# Optional RapidAPI Judge0 fallback. Server-side only. Not required for local runner.
# JUDGE0_API_KEY=your_judge0_api_key

# ML Engine Configuration (for student performance prediction)
ML_API_URL=http://localhost:5001
